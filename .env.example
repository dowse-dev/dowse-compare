# Copy to .env and fill in. Every key can have extras: NAME_2, NAME_3 ... NAME_9,
# used in order when one runs out of credit or is rate limited.

# Dowse, called through its public API like the others (https://dowse.dev/dashboard).
DOWSE_API_KEY=
# The other providers.
EXA_API_KEY=
TAVILY_API_KEY=
PERPLEXITY_API_KEY=
CONTEXT_DEV_API_KEY=
PARALLEL_API_KEY=
KEENABLE_API_KEY=

# The judge: Jev on OpenRouter (https://openrouter.ai/keys).
OPEN_ROUTER_API_KEY=
# JEV_MODEL=~typesafe/jev-latest

# Optional: Cloudflare Turnstile human check before fresh comparisons.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# SESSION_SECRET=

# Limits and storage.
# PORT=8130
# COMPARE_DAILY_CAP=30
# COMPARE_PER_IP_DAY=10
# COMPARE_DB=data/compare.db
# COMPARE_EXTRACT=false
